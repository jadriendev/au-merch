@media (max-width: 768px) {
    .nav-links {
        padding: 15px 15px;
    }

    section {
        padding: 5px 0;
        width: 100%;
    }
    
    .container {
        display: flex;
        flex-direction: column;
        padding: 10px 15px;
        width: 100%;
    }

    .containers {
        display: grid;
        grid-template-columns: 1fr;
        width: 100%;
    }

    .size-select,
    .color-select {
        flex-wrap: wrap;
    }

    .img-con {
        width: fit-content;
    }

    .img-child {
        width: 60px;
    }

    .info h2 {
        margin-top: -20px;
    }

    .button-con {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .authentic {
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .con {
        display: flex;
        flex-direction: column;
    }

    .line {
        display: none;
    }

    .tabs {
        display: flex;
        flex-direction: row;
    }
    
    .tabs button {
        border: none;
        gap: 1px;
    }
}